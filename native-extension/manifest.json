{
  "manifest_version": 3,
  "name": "Peek Native",
  "version": "0.11.0",
  "description": "Peek 原生双栏阅读器：保留 X 原生视频与评论；按需连接豆包或自定义 AI 服务，为可用字幕与完整长文生成摘要、时间轴和脑图。",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "layout-adapter-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "vendor/brand/icon.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "ai.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "ai-background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Peek 设置"
  },
  "optional_permissions": [
    "declarativeNetRequestWithHostAccess"
  ]
}
