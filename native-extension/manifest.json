{
  "manifest_version": 3,
  "name": "ThreadLume \u2014 AI Reader for X",
  "version": "0.12.0",
  "description": "Read Beyond the Post. A native two-column reader for X with AI summaries, video chapters and interactive mind maps.",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "layout-adapter-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "vendor/brand/icon.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "ai.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "ai-background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ThreadLume Settings"
  },
  "optional_permissions": [
    "declarativeNetRequestWithHostAccess"
  ]
}
